# Optional build-only network preparation for the pinned Ubuntu CUDA images.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN sed -i \
    -e 's|http://archive.ubuntu.com/ubuntu|https://archive.ubuntu.com/ubuntu|g' \
    -e 's|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g' \
    /etc/apt/sources.list \
    && printf 'Acquire::ForceIPv4 "true";\n' > /etc/apt/apt.conf.d/99recipe-ipv4
