# Copy to .env and edit, then run: bash recipe.sh
# These are trusted Bash assignments, not Docker --env-file input.
# File values win over ambient variables. Use RECIPE_ENV_FILE for another file.
# recipe.sh chooses build, resume or replacement. Preview: bash recipe.sh plan
# Stop/unload: bash recipe.sh stop. See docs/running.md for all actions.

# Keep CONTAINER_NAME stable when changing profiles; it selects the deployment.
# IMAGE is shared by the build and serving phases. Cache volumes are retained.
IMAGE=dsv4-nvfp4:recipe
CONTAINER_NAME=dsv4-nvfp4
KERNEL_CACHE=dsv4-nvfp4-kernels
HF_CACHE="$HOME/.cache/huggingface"

# Model download and the name your coding agent sends in API requests.
MODEL=nvidia/DeepSeek-V4-Flash-0731-NVFP4
REVISION=f1caa71142bd0be02f728c79f75042ac1e461579
SERVED_MODEL_NAME=dsv4-nvfp4
OFFLINE=1

# Network: 127.0.0.1 keeps the API on this host. No API authentication is configured.
# Change only if you understand the exposure and have restricted network access:
# use the host's LAN IPv4 address, or 0.0.0.0 for all IPv4 interfaces.
# Any client that can reach the published port can submit requests.
BIND_ADDRESS=127.0.0.1
PORT=8000
SERVER_PORT=8000

# Everyday coding/tools profile. See docs/running.md for alternatives.
# TP2 splits model computation across two GPUs. Other TP values aren't validated here.
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=1000000
GPU_MEMORY_UTILIZATION=0.96
MAX_NUM_SEQS=2
MAX_BATCHED_TOKENS=2048
LONG_PREFILL_TOKEN_THRESHOLD=1792
DSPARK=1
EAGER=0
MAX_CUDAGRAPH_CAPTURE_SIZE=16
MAX_JOBS=8

# Logging: INFO request IDs/parameters, bounded completed outputs, HTTP status.
# Prompt text requires explicit DEBUG configuration; see docs/running.md.
# LOG_REQUESTS=0 disables both prompt and output logs; access/stats logs remain.
LOG_REQUESTS=1
LOG_OUTPUTS=1
MAX_LOG_LEN=256
LOGGING_CONFIG="$RECIPE_DIR/config/logging.json"
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# Native Docker /health checks. First compilation can take several minutes.
# An unhealthy status reports failure; it doesn't restart the container.
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT_SECONDS=5
HEALTH_START_PERIOD=15m
HEALTH_RETRIES=3

# Build settings. Lower parallelism if compilation exhausts host RAM.
SOURCE_DIR="$RECIPE_DIR/work/vllm-source"
BASE_IMAGE=dsv4-sm120:source-20260804
ABI_IMAGE=dsv4-sm120:kernel-fix
BUILD_JOBS=16
NVCC_THREADS=8
BUILD_NETWORK=default
APT_HTTPS_IPV4=0

# Source/CUDA pins, FP8 KV and parser/backend choices remain fixed in code.
# K5 is a checkpoint constraint, not a tunable draft-length parameter here.
