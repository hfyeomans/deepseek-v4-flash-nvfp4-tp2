@@ -92,8 +93,44 @@
             return
         quant_cfg = getattr(hf_config, "quantization_config", None) or {}
         algo = (quant_cfg.get("moe_quant_algo") or "").upper() or None
+        if algo == "NVFP4" and "quantized_layers" in quant_cfg:
+            scope = quant_cfg["quantized_layers"]
+            target_layers = hf_config.num_hidden_layers
+            expected = {
+                f"layers.{index}.ffn.experts" for index in range(target_layers)
+            }
+            if not isinstance(scope, dict) or set(scope) != expected:
+                raise ValueError(
+                    "DeepSeek V4 NVFP4 scope must cover every main expert layer."
+                )
+            formats = {}
+            for name, declaration in scope.items():
+                if not isinstance(declaration, dict) or (
+                    declaration.get("quant_algo") != "NVFP4"
+                    or declaration.get("group_size") != 16
+                ):
+                    raise ValueError(f"Invalid DeepSeek V4 NVFP4 scope: {name}")
+                formats[name] = "NVFP4"
+            # Folded DSpark layers are numbered after the main model at runtime,
+            # but are stored as mtp.* in the checkpoint. They retain MXFP4.
+            draft_layers = len(getattr(hf_config, "dspark_target_layer_ids", []))
+            if draft_layers and "mtp.*" in quant_cfg.get("ignore", []):
+                for index in range(target_layers, target_layers + draft_layers):
+                    formats[f"layers.{index}.ffn.experts"] = "MXFP4"
+            self._resolved_moe_formats = formats
         self._resolved_moe_quant_algo = algo or ""
 
+    def _moe_format_for_prefix(self, prefix: str) -> str:
+        algo = self.moe_quant_algo
+        if self._resolved_moe_formats is None:
+            return algo
+        checkpoint_prefix = prefix.removeprefix("model.")
+        if checkpoint_prefix not in self._resolved_moe_formats:
+            raise ValueError(
+                f"Expert layer is outside DeepSeek V4 quantization scope: {prefix}"
+            )
+        return self._resolved_moe_formats[checkpoint_prefix]
+
     @property
